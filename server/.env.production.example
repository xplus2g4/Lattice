# Production `.env` for `docker compose -f compose.yaml -f compose.prod.yaml`. Copy to
# `server/.env` on the VM. Everything `.env.example` documents still applies; this file
# lists what a deployment sets differently, plus the values the web app and Caddy read.

# --- Deployment ---
# Hostnames Caddy answers on; both need an A record at the VM's static IP.
PUBLIC_HOST=
API_HOST=
POSTGRES_PASSWORD=
DEPLOYMENT_NAME=lattice
# Prometheus + Grafana (Grafana at https://$PUBLIC_HOST/grafana/, admin / GRAFANA_ADMIN_PASSWORD).
# Comment out to run without them; compose reads COMPOSE_PROFILES from this file.
COMPOSE_PROFILES=observability
GRAFANA_ADMIN_PASSWORD=

# --- Identity (Bearer only; the X-User header path stays off) ---
DEV_HEADER_AUTH=false
DEV_INVITE_CODE=
# First Google sign-in by this email bootstraps the instructor and owns every global Dataset.
INSTRUCTOR_EMAIL=
INSTRUCTOR_EMAILS=[]
# Shared web<->API HS256 key: `openssl rand -hex 32`.
TOKEN_SECRET=
# Encrypts the web app's session cookie: `openssl rand -hex 32`.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (paths inside the containers; compose mounts the volumes) ---
COGNEE_ROOT=/srv/.cognee
UPLOADS_DIR=/srv/data/uploads
MAX_UPLOAD_MB=25
COURSE_SUMMARY_REFRESH_S=3600
RELATED_COURSES_K=3

# --- Cognee: LLM and embeddings (see .env.example for why openai/ prefixes DeepSeek) ---
LLM_PROVIDER=custom
LLM_MODEL=openai/deepseek-v4-flash
LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
AUTO_FEEDBACK=false
ENABLE_BACKEND_ACCESS_CONTROL=true

# --- Telemetry, Spend, alerts ---
LOG_LEVEL=INFO
METRICS_TOKEN=
# Deployment-wide Spend per UTC day; priced above so it can be switched on with one line.
SPEND_PRICES_USD_PER_1M='{"deepseek-v4-flash":{"input":0.30,"output":1.20},"text-embedding-3-small":{"input":0.02}}'
#SPEND_CEILING_USD=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web app build (baked in at image build; a change needs `deploy.sh`) ---
# GA4 page views by route id only (security.md#egress). No consent banner exists yet.
VITE_GA_MEASUREMENT_ID=
