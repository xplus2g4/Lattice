# --- Lattice ---
# JSON list; the web app dev server runs on :3000
CORS_ORIGINS=["http://localhost:3000"]
# Lattice's own Postgres: application records only, never Cognee's storage.
DATABASE_URL=postgresql+asyncpg://lattice:lattice@localhost:5432/lattice
# Run `alembic upgrade head` on start-up. Handy in dev; deploys run it as a separate step.
DATABASE_AUTO_MIGRATE=false
# Honour the X-User header as identity. Dev only.
DEV_HEADER_AUTH=true
# Separate loopback MCP adapter: uv run python -m lattice.mcp (port 8001).
MCP_ENABLED=false
MCP_API_URL=http://127.0.0.1:8000
INSTRUCTOR_EMAIL=instructor@lattice.example
COGNEE_ROOT=.cognee
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=25
# How often the course summaries, one vector per course, are recomputed, and how many of
# the nearest courses /ask also searches (0 turns the related lane off).
COURSE_SUMMARY_REFRESH_S=3600
RELATED_COURSES_K=3

# --- Cognee: LLM (DeepSeek V4 Flash through LiteLLM's OpenAI-compatible route) ---
# `openai/` not `deepseek/`: DeepSeek rejects `response_format: json_schema` ("unavailable
# now", Sep 2026) and LiteLLM's table claims otherwise, so Cognee would keep retrying.
# The openai/ prefix makes Cognee use its prompted-JSON fallback, which DeepSeek accepts.
LLM_PROVIDER=custom
LLM_MODEL=openai/deepseek-v4-flash
LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_API_KEY=sk-...

# --- Cognee: embeddings (OpenAI text-embedding-3-small through LiteLLM) ---
# 8,191-token input window, the same as Cognee's default Chunk, so a whole Chunk is embedded.
# The local fastembed model this replaced truncated at 512 tokens. Changing model or
# dimensions invalidates every existing Dataset: wipe COGNEE_ROOT and re-cognify.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=sk-...

# --- Cognee: behaviour ---
# Skip the extra LLM call Cognee makes after each answer to tune its memory.
AUTO_FEEDBACK=false
# Per-principal dataset isolation at the vector and graph level. Cognee's default; stated
# so a downgrade is a visible diff.
ENABLE_BACKEND_ACCESS_CONTROL=true

# --- Evaluation judge (eval/eval_course.py): a second model family grades /ask answers ---
EVAL_JUDGE_MODEL=gpt-6-sol
EVAL_JUDGE_API_KEY=
