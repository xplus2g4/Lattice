# --- Lattice ---
# JSON list; the web app dev server runs on :3000
CORS_ORIGINS=["http://localhost:3000"]
# Lattice's own Postgres: application records only, never Cognee's storage.
DATABASE_URL=postgresql+asyncpg://lattice:lattice@localhost:5432/lattice
# Run `alembic upgrade head` on start-up. Handy in dev; deploys run it as a separate step.
DATABASE_AUTO_MIGRATE=false
# Honour the X-User header as identity. Dev only.
DEV_HEADER_AUTH=true
# Separate loopback MCP adapter: uv run python -m lattice.mcp (port 8001).
MCP_ENABLED=false
MCP_API_URL=http://127.0.0.1:8000
# Fixed invite code that always redeems (as student) while DEV_HEADER_AUTH is on.
# Lets local setups in without minting real invites; ignored when header auth is off.
DEV_INVITE_CODE=123456
# First Bearer sign-in by this email becomes an instructor, which is how the first
# invite gets minted in a closed-signup deployment.
INSTRUCTOR_EMAIL=instructor@lattice.example
# Extra emails that also bootstrap as instructor on sign-in (JSON list, like
# CORS_ORIGINS). Optional — most instructors after the first should come from an
# instructor-role invite (see /manage) rather than this list.
INSTRUCTOR_EMAILS=["bhavina.sk.04@gmail.com"]
COGNEE_ROOT=.cognee
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=25
# How often the course summaries, one vector per course, are recomputed, and how many of
# the nearest courses /ask also searches (0 turns the related lane off).
COURSE_SUMMARY_REFRESH_S=3600
RELATED_COURSES_K=3

# --- Lattice: Telemetry, Spend, alerts (all optional; unset means off) ---
# Root log level; Cognee, litellm and uvicorn share the JSON formatter.
#LOG_LEVEL=INFO
# Bearer token for GET /metrics. Unset: the route is a 404 and nothing scrapes it.
#METRICS_TOKEN=
# USD per million tokens per litellm model name (provider prefix stripped). A model with no
# entry still gets Spend rows, with usd null.
#SPEND_PRICES_USD_PER_1M='{"gpt-4o-mini":{"input":0.15,"output":0.60},"text-embedding-3-small":{"input":0.02}}'
# The Ceiling: deployment-wide Spend per UTC day. 80 %: alert. 100 %: /ask, /study/ask and
# /study/note.review return 429 with reset_at, and Cognify does not start. Unset: no Ceiling,
# no 429, no 80 % alert. Set, both LLM_MODEL and EMBEDDING_MODEL must be priced above.
#SPEND_CEILING_USD=10
# Watchdog alerts (ingest stuck > 10 min, loop stalled > 5 min, Ceiling 80 % / 100 %) go to
# this chat. Unset: alerts are logged at INFO instead of sent.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# Name the alerts open with.
#DEPLOYMENT_NAME=lattice

# --- Cognee: LLM (DeepSeek V4 Flash through LiteLLM's OpenAI-compatible route) ---
# `openai/` not `deepseek/`: DeepSeek rejects `response_format: json_schema` ("unavailable
# now", Sep 2026) and LiteLLM's table claims otherwise, so Cognee would keep retrying.
# The openai/ prefix makes Cognee use its prompted-JSON fallback, which DeepSeek accepts.
LLM_PROVIDER=custom
LLM_MODEL=openai/deepseek-v4-flash
LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_API_KEY=sk-...

# --- Cognee: embeddings (OpenAI text-embedding-3-small through LiteLLM) ---
# 8,191-token input window, the same as Cognee's default Chunk, so a whole Chunk is embedded.
# The local fastembed model this replaced truncated at 512 tokens. Changing model or
# dimensions invalidates every existing Dataset: wipe COGNEE_ROOT and re-cognify.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=sk-...

# --- Cognee: behaviour ---
# Skip the extra LLM call Cognee makes after each answer to tune its memory.
AUTO_FEEDBACK=false
# Per-principal dataset isolation at the vector and graph level. Cognee's default; stated
# so a downgrade is a visible diff.
ENABLE_BACKEND_ACCESS_CONTROL=true

# --- Evaluation judge (eval/eval_course.py): a second model family grades /ask answers ---
EVAL_JUDGE_MODEL=gpt-6-sol
EVAL_JUDGE_API_KEY=

# HS256 key for the Bearer tokens the web app mints after Google sign-in. Must match
# app/.env's TOKEN_SECRET; empty disables Bearer auth (header-only dev still works).
TOKEN_SECRET=

# Bound a stuck request. LiteLLM's default timeout is 600 s and the OpenAI SDK retries it twice,
# so one dead connection (the laptop slept mid-Cognify on 2026-09-23) cost an hour per chunk.
# Healthy extraction calls finish in about 100 s; Cognee's own retry layer still makes a second
# attempt on failure.
LLM_ARGS={"timeout": 300, "max_retries": 0}
