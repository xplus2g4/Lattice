VITE_API_URL=http://localhost:8000

# Google OAuth client (GCP console → Clients → Web application). The redirect URI must
# match the console entry exactly, including port and path.
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Session cookie seal + HS256 key for the Bearer tokens minted after sign-in.
# TOKEN_SECRET must match server/.env's; both are just long random strings locally.
SESSION_SECRET=...
TOKEN_SECRET=...
