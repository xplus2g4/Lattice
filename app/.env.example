# Base URL of the FastAPI server; every apiFetch call is prefixed with this.
VITE_API_URL=http://localhost:8000

# Google OAuth client ID (same value the server's GOOGLE_CLIENT_ID accepts).
# Empty hides the "Sign in with Google" button; the dev sign-in form still
# works in `vite dev`, and is the only option outside it.
VITE_GOOGLE_CLIENT_ID=

# Set to 1 to run the UI against the in-browser mock backend — no server, no
# session, no login gate. Unset (or anything else) uses the real API.
VITE_MOCK_API=
