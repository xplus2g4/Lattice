VITE_API_URL=http://localhost:8000
# Public frontend origin used by /landing metadata and sharing links.
VITE_SITE_URL=http://localhost:3000

# Google OAuth — the web app owns the sign-in handshake.
GOOGLE_CLIENT_ID=284525517761-01bb6cajeh55hah93rmgnp32appesm4v.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Encrypts the session cookie; HS256 key for the Bearer tokens the API verifies —
# TOKEN_SECRET must match server/.env.
SESSION_SECRET=
TOKEN_SECRET=

# Dev sign-in: shows the email box on /login and enables GET /auth/dev?email=…,
# which writes the session without Google. Off in production (route 404s).
# DEV_INVITE_CODE must match server/.env.
VITE_DEV_FAKE_AUTH=true
DEV_INVITE_CODE=123456
# GA4 measurement id (G-XXXXXXXXXX). Unset: no gtag script, no page views.
VITE_GA_MEASUREMENT_ID=
